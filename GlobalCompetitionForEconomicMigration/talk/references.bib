@techreport{porcherMeasuringInformationFrictions2025,
  type = {Measuring {{Information Frictions}} in {{Migration Decisions}}},
  title = {Measuring {{Information Frictions}} in {{Migration Decisions}}: {{A Revealed-Preference Approach}}},
